# Example Environment Variables
# Copy this file to .env and fill in your values

# MongoDB Atlas Connection URL
# Format: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://bloodflow_user:WIFIGHTERS@cluster0.xxxxx.mongodb.net/bloodflow_hub?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000
