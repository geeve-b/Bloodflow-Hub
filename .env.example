# PostgreSQL Database Configuration
# Examples:
# Local: postgresql://postgres:postgres@localhost:5432/bloodflow_hub
# Neon: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/bloodflow_hub?sslmode=require
# Supabase: postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloodflow_hub

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bloodflowhub@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=bloodflowhub@gmail.com
SMTP_FROM_NAME=LifeFlow - Blood Donation Hub

# Authentication
# Long random string used to sign login sessions (generate with: openssl rand -hex 32).
# If unset, a random one is generated at startup and everyone is logged out on restart.
SESSION_SECRET=change-me-to-a-long-random-string
# The account with this email is the platform administrator
ADMIN_EMAIL=bloodflowhub@gmail.com

# Development & Server Configuration
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
